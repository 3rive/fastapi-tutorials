{
  "name": "fastapi-tutorials",
  "install": "./scripts/cloud-agent-install.sh",
  "ports": [
    {
      "name": "api",
      "port": 8000
    }
  ],
  "terminals": [
    {
      "name": "api",
      "command": "bash -lc 'source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload'",
      "description": "FastAPI dev server with auto-reload on port 8000"
    }
  ]
}
